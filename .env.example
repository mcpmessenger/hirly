# Copy to .env.local. Everything is optional: with no keys the app runs in demo
# mode (in-memory data, simulated PayPal + AI) and shows a banner saying so.

# PayPal (https://developer.paypal.com/dashboard/): sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Supabase (https://supabase.com/dashboard): server-side only
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI proof verification (Vercel AI Gateway key). AI_MODEL is any gateway model id with vision.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# Auto-pay when AI says "pass" at or above this confidence. 0 = off (recommended).
AUTO_RELEASE_CONFIDENCE=0

# Resend notifications
RESEND_API_KEY=
EMAIL_FROM=Rukyr <onboarding@resend.dev>

# Platform
PLATFORM_FEE_PCT=15
# Optional: protects /api/cron/expire
CRON_SECRET=
